import express from "express";
import cors from "cors";
import dotenv from "dotenv";

dotenv.config();

const app = express();
app.use(cors());
app.use(express.json({ limit: "10mb" }));

const PORT = process.env.AI_PROXY_PORT || 8787;

function parseNineRouterResponse(rawText) {
  // Jika respons JSON normal
  try {
    return JSON.parse(rawText);
  } catch (_) {}

  // Jika respons berbentuk SSE: data: {...}\ndata: [DONE]
  const dataLines = rawText
    .split("\n")
    .map(line => line.trim())
    .filter(line => line.startsWith("data: "))
    .map(line => line.replace(/^data:\s*/, ""))
    .filter(line => line && line !== "[DONE]");

  if (dataLines.length === 0) {
    return null;
  }

  try {
    return JSON.parse(dataLines[dataLines.length - 1]);
  } catch (_) {
    return null;
  }
}

function extractInsight(parsed) {
  return (
    parsed?.choices?.[0]?.message?.content ||
    parsed?.choices?.[0]?.delta?.content ||
    parsed?.choices?.[0]?.text ||
    "Insight tidak tersedia."
  );
}

app.get("/api/health", (req, res) => {
  res.json({
    ok: true,
    service: "MONA LISA AI Proxy",
    gateway: "9Router",
    model: process.env.NINE_ROUTER_MODEL || "-",
    time: new Date().toISOString()
  });
});

app.post("/api/ai-insight", async (req, res) => {
  try {
    const baseUrl = process.env.NINE_ROUTER_BASE_URL || "http://127.0.0.1:20128/v1";
    const apiKey = process.env.NINE_ROUTER_API_KEY;
    const model = process.env.NINE_ROUTER_MODEL || "mmf/mimo-auto";

    if (!apiKey) {
      return res.status(500).json({
        success: false,
        message: "NINE_ROUTER_API_KEY belum diisi pada file .env"
      });
    }

    const payload = req.body || {};

    const systemPrompt = `
Anda adalah AI Insight untuk sistem MONA LISA PLN.

MONA LISA adalah sistem Monthly Load Analysis & Smart Assistant yang membantu operator membaca data pelanggan, pemakaian bulanan, grafik pemakaian, log WhatsApp, error log, dan audit trail.

Peran Anda:
1. Membaca ringkasan data operasional.
2. Mengidentifikasi data pelanggan yang belum lengkap.
3. Membantu mendeteksi potensi anomali pemakaian.
4. Memberikan rekomendasi tindak lanjut yang singkat dan teknis.
5. Tidak mengarang data yang tidak diberikan.

Gunakan bahasa Indonesia formal, jelas, dan ringkas.
AI hanya memberi insight pendukung. Keputusan akhir tetap pada operator.
`;

    const userPrompt = `
Berikut data dari Dashboard MONA LISA:

${JSON.stringify(payload, null, 2)}

Buat analisis dengan format berikut:

1. Ringkasan Sistem
2. Temuan Utama
3. Potensi Risiko
4. Rekomendasi Tindak Lanjut

Jangan terlalu panjang. Cocokkan gaya bahasa untuk dashboard monitoring operasional.
`;

    const response = await fetch(`${baseUrl}/chat/completions`, {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${apiKey}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        model,
        stream: false,
        messages: [
          { role: "system", content: systemPrompt },
          { role: "user", content: userPrompt }
        ],
        temperature: 0.2
      })
    });

    const rawText = await response.text();
    const parsed = parseNineRouterResponse(rawText);

    if (!response.ok || !parsed) {
      return res.status(response.status || 500).json({
        success: false,
        message: "9Router gagal memproses request.",
        raw: rawText.slice(0, 1000)
      });
    }

    return res.json({
      success: true,
      gateway: "9Router",
      model,
      insight: extractInsight(parsed),
      raw: parsed
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      message: "Gagal menghubungi 9Router. Menampilkan analisis offline.",
      error: error.message
    });
  }
});

app.listen(PORT, () => {
  console.log(`MONA LISA AI Proxy aktif di http://127.0.0.1:${PORT}`);
});
